{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "VVenC: encode 1 frame (single thread)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/bin/vvencapp",
            "args": [
                "--input", "${workspaceFolder}/build/debug/big-buck-bunny-first-frame.y4m",
                "--output", "${workspaceFolder}/build/debug/big-buck-bunny-1frame.vvc",
                "--frames", "1",
                "--preset", "medium",
                "--qp", "32",
                "--threads", "0",
                "--mtprofile", "0",
                "--ifp", "0",
                "--tiles", "1x1",
                "--verbosity", "6",
                "--stats", "0"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "externalConsole": false,
            "internalConsoleOptions": "openOnSessionStart",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "vvenc: prepare 1-frame debug input"
        }
    ]
}
